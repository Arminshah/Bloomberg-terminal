{
  "name": "armin-terminal",
  "private": true,
  "version": "1.1.0",
  "description": "A Bloomberg-style market terminal for the browser and Windows desktop: command line, yellow keys, panels, charts and 66 functions on a calibrated simulated market with optional live feeds.",
  "author": "Armin",
  "homepage": "https://github.com/arminshah/bloomberg-terminal",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single && node scripts/artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "snapshot": "node scripts/snapshot.ts",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win --x64 --publish never",
    "desktop:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.5",
    "electron-builder": "26.16.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.armin.terminal",
    "productName": "Armin Terminal",
    "copyright": "Copyright © 2026 Armin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Armin Terminal",
      "artifactName": "Armin-Terminal-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Armin-Terminal-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
