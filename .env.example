# Provider credentials for the desktop app. Copy to .env (only read when running from source)
# or set them as environment variables, or save them in the app's PROV screen.
# Never commit a filled-in copy.

# FRED API key: 32 lowercase letters and digits, free from https://fredaccount.stlouisfed.org
FRED_API_KEY=

# Massive (formerly Polygon.io) API key, free Stocks Basic plan. Planned; not used yet.
MASSIVE_API_KEY=

# SEC EDGAR asks every client to name itself and give a contact email it can reach,
# for example: Armin Terminal your-address@your-domain. Planned; not used yet.
SEC_USER_AGENT=

# Yahoo Finance needs no key. The app keeps no Yahoo login, cookie or credential in source control.
