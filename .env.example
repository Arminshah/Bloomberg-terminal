# Armin Terminal configuration. Copy to .env when running from source (npm run desktop),
# or set these as environment variables before starting the app. Keys can also be saved on
# the provider screen (PROV), which encrypts them with the system's key store.
# An environment variable wins over .env, and .env wins over a value saved in the app.
# Never commit a filled-in copy: .env is ignored by git.
#
# Keys are only ever read by the desktop app's main process. None of them is built into the
# web bundle, sent to a screen or written to a log.

# ---------------------------------------------------------------- price sources (switches)

# Yahoo Finance: quotes, history, company profiles and statements. Unofficial, personal use
# only; its terms forbid automated collection, a risk this private app accepts. Options,
# news and analyst data stay off whatever this says. true (default) or false.
YAHOO_PRICES_ENABLED=true

# Kraken's public market data for the ten crypto lines (no key). false hands them back to
# Yahoo when Yahoo is on. true (default) or false.
KRAKEN_ENABLED=true

# ---------------------------------------------------------------- keys (all free)

# FRED (St. Louis Fed): US release dates and values, OECD series. Free key, 32 lowercase
# letters and digits: https://fredaccount.stlouisfed.org . Without it ECO and ECST say so.
FRED_API_KEY=

# SEC EDGAR: the SEC asks every program to name itself and give a contact email it can reach,
# for example "Armin Terminal your-address@your-domain". Without it nothing is sent to the
# SEC and FILINGS says what is needed. Use your own address; the app never invents one.
SEC_USER_AGENT=

# CoinGecko Demo plan (free, 10,000 calls a month): market value and circulating supply of
# the listed coins, aggregated, shown with "Powered by CoinGecko". Without it those fields
# stay empty: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Massive (formerly Polygon.io), free Stocks Basic plan: end-of-day US stock history.
# Personal, non-commercial use only. Not used yet: the adapter is planned.
MASSIVE_API_KEY=

# ---------------------------------------------------------------- browser build only

# true opens the browser build straight into the demo, whose every value is simulated and
# marked DEMO DATA. Off by default; the desktop app never runs the demo.
DEMO_MODE=false
